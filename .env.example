# Configuración de Minuta
# Copia este archivo a .env y completa tus credenciales locales.

# Clave de API de Google Gemini (requerida para modo nube y generación)
GEMINI_API_KEY=

# Proveedor LLM por defecto: gemini | ollama
MINUTA_PROVEEDOR=gemini

# Host de Ollama para ejecución local (por defecto http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
